{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/control/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/control/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/control",
  "projects": {
    "commons": {
      "type": "library",
      "root": "libs/commons",
      "entryFile": "index",
      "sourceRoot": "libs/commons/src",
      "compilerOptions": {
        "tsConfigPath": "libs/commons/tsconfig.lib.json"
      }
    },
    "control": {
      "type": "application",
      "root": "apps/control",
      "entryFile": "main",
      "sourceRoot": "apps/control/src",
      "compilerOptions": {
        "tsConfigPath": "apps/control/tsconfig.app.json"
      }
    },
    "dashboard": {
      "type": "application",
      "root": "apps/dashboard",
      "entryFile": "main",
      "sourceRoot": "apps/dashboard/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dashboard/tsconfig.app.json"
      }
    },
    "result-sink": {
      "type": "application",
      "root": "apps/result-sink",
      "entryFile": "main",
      "sourceRoot": "apps/result-sink/src",
      "compilerOptions": {
        "tsConfigPath": "apps/result-sink/tsconfig.app.json"
      }
    },
    "result-store": {
      "type": "application",
      "root": "apps/result-store",
      "entryFile": "main",
      "sourceRoot": "apps/result-store/src",
      "compilerOptions": {
        "tsConfigPath": "apps/result-store/tsconfig.app.json"
      }
    },
    "scheduler": {
      "type": "application",
      "root": "apps/scheduler",
      "entryFile": "main",
      "sourceRoot": "apps/scheduler/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduler/tsconfig.app.json"
      }
    },
    "scraper-worker": {
      "type": "application",
      "root": "apps/scraper-worker",
      "entryFile": "main",
      "sourceRoot": "apps/scraper-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scraper-worker/tsconfig.app.json"
      }
    }
  }
}