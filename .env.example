NODE_ENV=development
RMQ_URI=amqp://guest:guest@localhost:5672
SCRAPER_MAX_RETRIES=3
SQLITE_PATH=data/results.sqlite
# Worker freshness skip: skip the fetch for a detail/episode page when a stored row
# was updated within this many hours. Set 0 to disable (always fetch). Manual
# dashboard re-crawls always bypass this.
SKIP_FRESH_HOURS=72
# Browser engine: set to "false" to run headful (visible) for debugging; any other value = headless.
BROWSER_HEADLESS=true
# Dashboard HTTP app (apps/dashboard): Basic-auth credentials + listen port.
DASH_USER=admin
DASH_PASS=admin
DASH_PORT=3001
