NODE_ENV=development
RMQ_URI=amqp://guest:guest@localhost:5672
SCRAPER_MAX_RETRIES=3
SQLITE_PATH=data/results.sqlite
# Worker freshness skip: skip the fetch for a detail/episode page when a stored row
# was updated within this many hours. Set 0 to disable (always fetch). Manual
# dashboard re-crawls always bypass this.
SKIP_FRESH_HOURS=72
# Worker consume throttle: sleep this many ms before processing each job, pacing
# the worker against target sites. Set 0 to disable.
CONSUME_DELAY_MS=1000
# Worker in-flight jobs pulled from the queue at once. 1 serializes the heavy
# per-episode browser workflow; raise for more concurrency.
PREFETCH_COUNT=1
# Browser engine: set to "false" to run headful (visible) for debugging; any other value = headless.
BROWSER_HEADLESS=true
# Dashboard HTTP app (apps/dashboard): Basic-auth credentials + listen port.
DASH_USER=admin
DASH_PASS=admin
DASH_PORT=3001
# Downloader app (apps/downloader): S3/MinIO target for archived episode videos.
# Bucket must be pre-created (e.g. `mc mb local/anime-archive`). Path-style for MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=anime-archive
S3_FORCE_PATH_STYLE=true
