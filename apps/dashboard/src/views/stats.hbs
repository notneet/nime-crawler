<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    <h1>Stats</h1>
    <p class="mt-2 text-xs text-mute">pipeline snapshot · sqlite store</p>
  </div>
  <span class="pill">updated {{newestAnimeUpdatedAt}}</span>
</div>

<div class="grid grid-cols-2 gap-px border border-edge bg-edge sm:grid-cols-3 lg:grid-cols-5">
  <div class="bg-panel p-5">
    <div class="label">Anime</div>
    <div class="font-display text-3xl font-900 text-acid">{{counts.anime}}</div>
  </div>
  <div class="bg-panel p-5">
    <div class="label">Episodes</div>
    <div class="font-display text-3xl font-900">{{counts.episode}}</div>
  </div>
  <div class="bg-panel p-5">
    <div class="label">Mirrors</div>
    <div class="font-display text-3xl font-900">{{counts.mirror}}</div>
  </div>
  <div class="bg-panel p-5">
    <div class="label">Downloads</div>
    <div class="font-display text-3xl font-900">{{counts.download}}</div>
  </div>
  <div class="bg-panel p-5">
    <div class="label">Genres</div>
    <div class="font-display text-3xl font-900">{{counts.genre}}</div>
  </div>
</div>

<h2 class="mt-10 mb-3">Coverage gaps</h2>
<div class="card divide-y divide-edge">
  <div class="flex items-center justify-between px-5 py-3">
    <span class="text-sm">Anime missing score</span>
    <span class="gap font-display text-xl font-800">{{gaps.animeMissingScore}}</span>
  </div>
  <div class="flex items-center justify-between px-5 py-3">
    <span class="text-sm">Anime missing studio</span>
    <span class="gap font-display text-xl font-800">{{gaps.animeMissingStudio}}</span>
  </div>
  <div class="flex items-center justify-between px-5 py-3">
    <span class="text-sm">Mirrors unresolved</span>
    <span class="gap font-display text-xl font-800">{{gaps.mirrorsUnresolved}}</span>
  </div>
</div>
