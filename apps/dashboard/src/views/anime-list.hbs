<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <h1>Anime <span class="text-mute">/ {{total}}</span></h1>
  <form method="get" action="/anime" class="flex items-end gap-2">
    <div>
      <label class="label" for="q">Search title</label>
      <input id="q" type="text" name="q" value="{{q}}" placeholder="search title" class="input w-64" />
    </div>
    <button type="submit" class="btn btn-acid">Search</button>
  </form>
</div>

<div class="card overflow-hidden">
  <table class="tbl">
    <thead>
      <tr><th class="w-20">ID</th><th>Title</th><th class="w-32">Status</th><th class="w-24">Score</th></tr>
    </thead>
    <tbody>
      {{#each rows}}
        <tr>
          <td class="text-mute">{{this.id}}</td>
          <td><a href="/anime/{{this.id}}" class="font-bold">{{this.title}}</a></td>
          <td><span class="pill">{{this.status}}</span></td>
          <td class="font-bold text-acid">{{this.score}}</td>
        </tr>
      {{else}}
        <tr><td colspan="4" class="py-10 text-center text-mute">no results</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{> pager pager}}
