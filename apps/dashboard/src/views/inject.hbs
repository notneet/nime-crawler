<div class="crumb"><span class="text-fg">Inject</span></div>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <h1>Inject link</h1>
  <button type="button" class="btn btn-ghost" onclick="document.getElementById('inject-help').showModal()">How to inject</button>
</div>

<div id="flash" class="empty:hidden mb-4"></div>

{{#if sources.length}}
  <form class="card max-w-2xl p-6 space-y-4" hx-post="/inject" hx-target="#flash" hx-swap="innerHTML"
    hx-on::after-request="if(event.detail.successful) this.reset(); window.injectSyncStages && window.injectSyncStages()">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="label">Source</label>
        <select name="source" id="inject-source" class="input" onchange="window.injectSyncStages()">
          {{#each sources}}<option value="{{this.source}}">{{this.source}}</option>{{/each}}
        </select>
      </div>
      <div>
        <label class="label">Stage</label>
        <select name="stage" id="inject-stage" class="input"></select>
      </div>
    </div>
    <div>
      <label class="label">URL</label>
      <input name="url" id="inject-url" class="input" placeholder="https://…" required />
      <p id="inject-hint" class="mt-1 text-[0.68rem] text-mute"></p>
    </div>
    <label class="flex w-fit cursor-pointer select-none items-center gap-2.5">
      <input type="checkbox" name="noDiscover" class="check" />
      <span class="font-mono text-[0.62rem] font-bold uppercase tracking-[0.22em] text-mute">This stage only (no discover)</span>
    </label>
    <div class="flex gap-2">
      <button type="submit" class="btn btn-acid">Inject</button>
      <button type="button" id="inject-test-btn" class="btn btn-ghost">Test</button>
    </div>
  </form>
{{else}}
  <div class="card p-6 text-sm text-mute">No enabled adapters. Inject is unavailable until a site adapter is registered.</div>
{{/if}}

<dialog id="inject-help" class="card fixed left-1/2 top-1/2 m-0 w-[calc(100%-2rem)] max-w-lg -translate-x-1/2 -translate-y-1/2 p-0 text-fg backdrop:bg-ink/70 backdrop:backdrop-blur-sm">
  <div class="border-b border-edge px-6 py-4 flex items-center justify-between">
    <h2 class="!text-fg">How to inject</h2>
    <button type="button" class="btn btn-ghost !px-2.5 !py-1.5" onclick="document.getElementById('inject-help').close()">Close</button>
  </div>
  <div class="px-6 py-5 space-y-3 text-sm leading-relaxed">
    <p>Inject pushes a single URL into the crawl pipeline, the same path a scheduled crawl uses.</p>
    <ol class="list-decimal space-y-1.5 pl-5">
      <li><span class="text-fg">Source</span> — pick a registered adapter. Only enabled adapters appear.</li>
      <li><span class="text-fg">Stage</span> — choose the entry stage. <span class="pill">index</span> seeds a listing page, <span class="pill">detail</span> an anime page, <span class="pill">episode</span> an episode page.</li>
      <li><span class="text-fg">URL</span> — must begin with the selected source's base URL, otherwise it's rejected.</li>
    </ol>
    <p class="text-mute">The job is published to <span class="font-mono text-fg">anime.crawl</span> and processed asynchronously by the scraper worker. Watch Stats for results.</p>
  </div>
</dialog>

{{> test-result-dialog}}

<script type="application/json" id="inject-sources">{{{sourcesJson}}}</script>
<script src="/static/js/test-modal.js"></script>
<script src="/static/js/inject.js"></script>
