<h1>{{episode.title}}</h1>
<form hx-post="/episode/{{episode.id}}" hx-target="#flash" hx-swap="innerHTML">
  <p>Title: <input name="title" value="{{episode.title}}" /></p>
  <p>Number: <input name="number" value="{{episode.number}}" /></p>
  <p>Stream URL: <input name="streamUrl" value="{{episode.streamUrl}}" /></p>
  <p>Posted by: <input name="postedBy" value="{{episode.postedBy}}" /></p>
  <p>Release info: <input name="releaseInfo" value="{{episode.releaseInfo}}" /></p>
  <button type="submit">Save</button>
</form>
<div id="flash"></div>
<button hx-post="/episode/{{episode.id}}/recrawl" hx-target="#flash" hx-swap="innerHTML">Re-crawl</button>
<button hx-delete="/episode/{{episode.id}}" hx-confirm="Delete this episode?" hx-target="body">Delete</button>

<h2>Mirrors</h2>
<table>
  <thead><tr><th>Quality</th><th>Host</th><th>Stream URL</th></tr></thead>
  <tbody>{{#each mirrors}}<tr><td>{{this.quality}}</td><td>{{this.host}}</td><td>{{this.streamUrl}}</td></tr>{{/each}}</tbody>
</table>

<h2>Downloads</h2>
<table>
  <thead><tr><th>Quality</th><th>Host</th><th>Size</th><th>URL</th></tr></thead>
  <tbody>{{#each downloads}}<tr><td>{{this.quality}}</td><td>{{this.host}}</td><td>{{this.size}}</td><td>{{this.url}}</td></tr>{{/each}}</tbody>
</table>
