<div class="crumb"><a href="/anime">Anime</a><span>/</span><span class="text-fg">{{anime.id}}</span></div>

<div class="mb-6">
  <h1 class="max-w-3xl">{{anime.title}}</h1>
  <div class="mt-4 flex flex-wrap gap-2">
    {{#if anime.url}}<a href="{{anime.url}}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost !no-underline">Source ↗</a>{{/if}}
    <button class="btn btn-ghost" hx-post="/anime/{{anime.id}}/recrawl" hx-confirm="Re-crawl this anime from source?" data-confirm-label="Re-crawl" hx-target="#flash" hx-swap="innerHTML">Re-crawl</button>
    <button class="btn btn-danger" hx-delete="/anime/{{anime.id}}" hx-confirm="Delete this anime?" hx-target="body">Delete</button>
  </div>
</div>

<div id="flash" class="empty:hidden mb-4"></div>

<div class="grid gap-6 lg:grid-cols-3">
  <form class="card lg:col-span-2 p-6 space-y-4" hx-post="/anime/{{anime.id}}" hx-target="#flash" hx-swap="innerHTML">
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="label">Title</label><input name="title" value="{{anime.title}}" class="input" /></div>
      <div><label class="label">Title JP</label><input name="titleJP" value="{{anime.titleJP}}" class="input" /></div>
      <div><label class="label">Status</label><input name="status" value="{{anime.status}}" class="input" /></div>
      <div><label class="label">Score</label><input name="score" value="{{anime.score}}" class="input" /></div>
      <div><label class="label">Studio</label><input name="studio" value="{{anime.studio}}" class="input" /></div>
      <div><label class="label">Total Episodes</label><input name="totalEpisodes" value="{{anime.totalEpisodes}}" class="input" /></div>
    </div>
    <div><label class="label">Synopsis</label><textarea name="synopsis" class="input">{{anime.synopsis}}</textarea></div>
    <button type="submit" class="btn btn-acid">Save</button>
  </form>

  <div class="space-y-6">
    {{#if anime.thumbnailUrl}}
      <div class="card overflow-hidden">
        <img src="{{anime.thumbnailUrl}}" alt="{{anime.title}}" loading="lazy" referrerpolicy="no-referrer"
             class="aspect-[3/4] w-full border-b-2 border-ink bg-blush object-cover" />
        {{#if anime.titleJP}}<div class="px-4 py-2.5 font-jp text-sm text-mute">{{anime.titleJP}}</div>{{/if}}
      </div>
    {{/if}}

    <div class="card p-6">
      <h2 class="mb-3">Browse</h2>
      <div class="flex flex-wrap gap-2">
        <a href="/anime/{{anime.id}}/episodes" class="btn btn-ghost !no-underline">Episodes</a>
        <a href="/anime/{{anime.id}}/mirrors" class="btn btn-ghost !no-underline">Mirrors</a>
        <a href="/anime/{{anime.id}}/downloads" class="btn btn-ghost !no-underline">Downloads</a>
        <a href="/anime/{{anime.id}}/batch" class="btn btn-ghost !no-underline">Batch</a>
      </div>
    </div>

    <div class="card p-6">
      <h2 class="mb-3">Genres</h2>
      <div class="flex flex-wrap gap-1.5">
        {{#each genres}}<span class="pill">{{this.name}}</span>{{else}}<span class="text-xs text-mute">none</span>{{/each}}
      </div>
    </div>

    <div class="card p-6">
      <h2 class="mb-3">Episodes</h2>
      <ul class="space-y-1.5 text-sm">
        {{#each episodes}}<li><a href="/episode/{{this.id}}">{{this.title}}</a></li>{{else}}<li class="text-mute">none</li>{{/each}}
      </ul>
    </div>
  </div>
</div>
