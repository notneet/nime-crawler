<div class="crumb"><a href="/adapter">Adapters</a><span>/</span><span class="text-fg">{{#if isNew}}new{{else}}{{adapter.source}}{{/if}}</span></div>

<h1 class="mb-6">{{#if isNew}}New adapter{{else}}{{adapter.source}}{{/if}}</h1>

{{#if error}}<div class="card mb-4 border-deep p-4 text-deep">{{error}}</div>{{/if}}
{{#if message}}<div class="card mb-4 p-4">{{message}}</div>{{/if}}

<form class="card p-6 space-y-4" method="post" action="{{#if isNew}}/adapter{{else}}/adapter/{{adapter.source}}{{/if}}">
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="label">Source</label>
      <input name="source" value="{{adapter.source}}" class="input" {{#unless isNew}}readonly{{/unless}} required />
    </div>
    <div><label class="label">Base URL</label><input name="baseUrl" value="{{adapter.baseUrl}}" class="input" required /></div>
  </div>
  <label class="flex w-fit cursor-pointer select-none items-center gap-2.5">
    <input type="checkbox" name="enabled" class="check" {{#if adapter.enabled}}checked{{/if}} />
    <span class="font-mono text-[0.62rem] font-bold uppercase tracking-[0.22em] text-mute">Enabled</span>
  </label>
  <div>
    <div class="mb-1.5 flex items-center justify-between">
      <label class="label !mb-0">Stages</label>
      <div class="flex items-center gap-2">
        <select id="add-stage-select" class="input !w-auto py-1 text-xs"></select>
        <button type="button" class="btn btn-ghost" data-act="add-stage">+ stage</button>
      </div>
    </div>
    <div id="stage-editor" class="space-y-4"></div>
    <input type="hidden" name="stages" id="stages-field" />
    <textarea id="stages-data" hidden>{{stagesJson}}</textarea>
    <p id="editor-error" class="mt-2 hidden text-xs font-bold text-deep"></p>
  </div>
  <button type="submit" class="btn btn-acid">Save</button>
</form>

{{> test-result-dialog}}

<script src="/static/js/test-modal.js"></script>
<script src="/static/js/adapter-editor.js"></script>
